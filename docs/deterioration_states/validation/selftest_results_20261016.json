  "state_names": {
    "history_starts_delinquent": {
      "display": "Not classified \u2014 history starts delinquent",
      "remark": "Data quality, not behaviour: the oldest month in the string is already delinquent \u2014 typically a restructured card/loan re-opened at its old bucket, a migrated account or missing history. Rare; treatment of restructured accounts is deferred."
    },
    "early_payment_default": {
      "display": "Early payment default (EPD)",
      "remark": "Never paid since crossing bucket 2 and still falling, at most 3 months after the first bill. Called 'bust-out' internally \u2014 but classic bust-out fraud (good history, limit build-up, then max-out) shows as a seasoned straight roller and needs a fraud overlay on spend data."
    },
    "stabilized": {
      "display": "Stabilized",
      "remark": "The bank's 5-of-6 stabilized rule, plus a long-run clause (6+ months since first reaching 4, at most one bucket higher than 6 months ago) so oscillating payers and accounts that just paid down are not mislabelled."
    },
    "paying_since_4": {
      "display": "Paying since bucket 4 (tested, not used)",
      "remark": "Rejected \u2014 current-behaviour state that belongs to credibility (money coming in)."
    },
    "repeat_delinquent": {
      "display": "Repeat delinquent (re-default)",
      "remark": "Re-default within 24 months of curing a spell that reached bucket 3; collections 'recidivism'."
    },
    "straight_roller": {
      "display": "Straight roller",
      "remark": "Rolled straight to bucket 4 (no payment on the way down). Describes how they fell in \u2014 some have paid since."
    },
    "straight_roller_seasoned": {
      "display": "Seasoned straight roller",
      "remark": "Rolled straight to bucket 4 after at least a year on book (seasoned)."
    },
    "straight_roller_early_life": {
      "display": "Early-life straight roller",
      "remark": "Rolled straight to bucket 4 in the first year on book (early-life default)."
    },
    "slow_roller": {
      "display": "Slow roller (partial payer)",
      "remark": "Paid something on the way down to bucket 4 but kept rolling. Also called partial payer."
    },
    "slow_roller_intermittent": {
      "display": "Intermittent payer",
      "remark": "Slow roller that paid one month here and there on the way down."
    },
    "slow_roller_erratic": {
      "display": "Erratic payer",
      "remark": "Slow roller that caught up 2+ months at once on the way down, then rolled again."
    }
  },
