  "state_names": {
    "early_payment_default": {
      "display": "Early payment default (EPD)",
      "remark": "Never really paid: defaulted within the first three payments. Called 'bust-out' internally \u2014 but classic bust-out fraud (good history, limit build-up, then max-out) shows as a seasoned straight roller and needs a fraud overlay on spend data."
    },
    "stabilized": {
      "display": "Stabilized",
      "remark": "The bank's 5-of-6 stabilized rule, plus a long-run clause (6+ months in buckets 4+, at most one bucket higher than 6 months ago) so oscillating payers and accounts that just paid down are not mislabelled."
    },
    "paying_since_4": {
      "display": "Paying since bucket 4 (tested, not used)",
      "remark": "Rejected \u2014 current-behaviour state that belongs to credibility (money coming in)."
    },
    "repeat_delinquent": {
      "display": "Repeat delinquent (re-default)",
      "remark": "Re-default after a cured spell; collections 'recidivism'."
    },
    "straight_roller": {
      "display": "Straight roller",
      "remark": "Rolled through every bucket without paying."
    },
    "straight_roller_seasoned": {
      "display": "Seasoned straight roller",
      "remark": "Straight roller after at least a year on book (seasoned)."
    },
    "straight_roller_early_life": {
      "display": "Early-life straight roller",
      "remark": "Straight roller in the first year on book (early-life default)."
    },
    "slow_roller": {
      "display": "Slow roller (partial payer)",
      "remark": "Paid something on the way down but kept rolling. Also called partial payer."
    },
    "slow_roller_intermittent": {
      "display": "Intermittent payer",
      "remark": "Slow roller that paid one month here and there."
    },
    "slow_roller_erratic": {
      "display": "Erratic payer",
      "remark": "Slow roller that caught up 2+ months at once, then rolled again."
    }
  },
