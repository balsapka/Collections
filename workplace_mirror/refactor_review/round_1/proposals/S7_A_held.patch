-            node(
-                func=build_cc_spell_table,
-                inputs=["raw_stg_billing", "cc_spine"],
-                outputs="crx_cc_spell_table",
-                name="build_crx_cc_spell_table",
-                tags=["crx", "spell", "t03"],
-            ),
-        ],
-        tags=["crx_persona"],
-    )
